# SPDX-License-Identifier: Apache-2.0 OR MIT

pkgbase=mailslot
pkgname=(mailslot mailslot-cli)
pkgver=0.1.0
pkgrel=1
pkgdesc='A private drop slot for files sent your way'
arch=(x86_64 aarch64)
url='https://github.com/liminal-hq-labs/mailslot'
license=('Apache-2.0 OR MIT')
makedepends=(cargo gtk4 libadwaita)
options=(!lto)
source=("$pkgbase-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Run `updpkgsums` when cutting a release.
sha256sums=('SKIP')

prepare() {
	cd "$pkgbase-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
	cd "$pkgbase-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	cargo build --frozen --release --workspace
}

check() {
	cd "$pkgbase-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	cargo test --frozen --workspace --exclude mailslot-gtk
}

_install_cli() {
	install -Dm755 target/release/mailslot-cli -t "$pkgdir/usr/bin/"
	if [ -f target/release/mailslotd ]; then
		install -Dm755 target/release/mailslotd -t "$pkgdir/usr/bin/"
		install -Dm644 data/mailslotd.service -t "$pkgdir/usr/lib/systemd/user/"
	fi
	install -Dm644 data/man/mailslot-cli.1 -t "$pkgdir/usr/share/man/man1/"
	install -Dm644 data/completions/mailslot-cli.bash "$pkgdir/usr/share/bash-completion/completions/mailslot-cli"
	install -Dm644 data/completions/mailslot-cli.fish "$pkgdir/usr/share/fish/vendor_completions.d/mailslot-cli.fish"
	install -Dm644 data/completions/_mailslot-cli "$pkgdir/usr/share/zsh/site-functions/_mailslot-cli"
	install -Dm644 LICENSE-APACHE LICENSE-MIT -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_mailslot() {
	pkgdesc='A private drop slot for files sent your way (desktop app and command line)'
	depends=('gtk4>=4.20' 'libadwaita>=1.8' glibc gcc-libs)
	optdepends=('xdg-desktop-portal: file chooser and notifications under sandboxing')
	provides=(mailslot-cli)
	conflicts=(mailslot-cli)

	cd "$pkgbase-$pkgver"
	install -Dm755 target/release/mailslot -t "$pkgdir/usr/bin/"
	_install_cli
	install -Dm644 data/ca.liminalhq.mailslot.desktop -t "$pkgdir/usr/share/applications/"
	install -Dm644 data/ca.liminalhq.mailslot.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
	install -Dm644 data/icons/hicolor/scalable/apps/ca.liminalhq.mailslot.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
	install -Dm644 data/icons/hicolor/symbolic/apps/ca.liminalhq.mailslot-symbolic.svg -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps/"
}

package_mailslot-cli() {
	pkgdesc='Send files to a Mailslot and receive them headless (no GTK)'
	depends=(glibc gcc-libs)

	cd "$pkgbase-$pkgver"
	_install_cli
}
