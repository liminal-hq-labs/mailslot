#!/usr/bin/env bash
# AppRun for the Mailslot AppImage: runs the GUI, the CLI when the first argument is `mailslot-cli`, or the daemon for `mailslotd`.
#
# (c) Copyright 2026 Liminal HQ, Scott Morris
# SPDX-License-Identifier: Apache-2.0 OR MIT

set -e

here="$(dirname "$(readlink -f "${0}")")"
export APPDIR="${APPDIR:-$here}"

# The generated wrapper that calls this script has already sourced the GTK plugin hooks (schemas,
# loaders, icon theme paths). package-appimage.sh removes the lines that force GTK_THEME and
# GDK_BACKEND, so libadwaita keeps following the system colour scheme, accent and Wayland session.

export PATH="$APPDIR/usr/bin:$PATH"

if [ "${1:-}" = mailslot ]; then
	shift
fi
if [ "${1:-}" = mailslot-cli ]; then
	shift
	exec "$APPDIR/usr/bin/mailslot-cli" "$@"
fi
if [ "${1:-}" = mailslotd ] && [ -x "$APPDIR/usr/bin/mailslotd" ]; then
	shift
	exec "$APPDIR/usr/bin/mailslotd" "$@"
fi
exec "$APPDIR/usr/bin/mailslot" "$@"
